# Firebase web app config — from Firebase Console → Project settings → Your apps (Web).
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase emulators in dev.
VITE_USE_EMULATORS=false
